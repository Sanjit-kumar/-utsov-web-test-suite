{
  "name": "utsov-web-test-suite",
  "version": "1.0.0",
  "description": "Comprehensive automated test suite for UTSOV Durga Puja 2026 website — functional, integration, and security tests with email reporting",
  "scripts": {
    "test": "node run-tests.js",
    "test:functional": "playwright test tests/functional/ --reporter=json",
    "test:integration": "playwright test tests/integration/ --reporter=json",
    "test:security": "playwright test tests/security/ --reporter=json",
    "test:all": "playwright test --reporter=json,list",
    "report": "node email/send-report.js"
  },
  "dependencies": {
    "axios": "^1.6.5",
    "dayjs": "^1.11.10",
    "dotenv": "^16.3.1",
    "nodemailer": "^6.9.8",
    "qrcode-terminal": "^0.12.0",
    "whatsapp-web.js": "^1.34.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.41.0"
  }
}
